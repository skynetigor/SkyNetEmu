  *
  * This function returns -errno if an error occurred, otherwise 0.
  */
+static int allow_ordinary_aarch64_ioctl(struct sock_fprog *program)
+{
+	/* Keep requests handled by this pinned core on its normal trace path.
+	 * Other ABIs also retain the complete original filter. */
+	struct sock_filter statements[] = {
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, arch)),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, AUDIT_ARCH_AARCH64, 0, 11),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, nr)),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 29, 0, 9),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[1])),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETSF, 7, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCGETS2, 6, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETS2, 5, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETSW2, 4, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETSF2, 3, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, (uint32_t) FICLONE, 2, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, SIOCGIFINDEX, 1, 0),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW)
+	};
+	return add_statements(program, sizeof(statements) / sizeof(statements[0]), statements);
+}
+
