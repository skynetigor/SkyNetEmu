+test('escaped log excerpts larger than 16 KiB reach the bulk indexer intact', async () => {
+  const h = await harness();
+  try {
+    const event = base({
+      'event.dataset': 'skynet.error', 'event.action': 'launch',
+      'error.stack_trace': '\u0001'.repeat(8192),
+      'skynet.renderer.diagnostics': '\u0001'.repeat(2048),
+      'skynet.linux.setup': '\u0001'.repeat(1000),
+      'skynet.linux.logs': '\u0001'.repeat(6000),
+      'skynet.linux.seconds_running': 40,
+    });
+    const bytes = Buffer.byteLength(JSON.stringify(event));
+    assert.ok(bytes > 16 * 1024 && bytes < 128 * 1024);
+    const response = await h.post([event]);
+    assert.deepEqual(await response.json(), { accepted: 1, rejected: 0 });
+    await h.indexer.flush();
+    const doc = JSON.parse(h.bulks[0][1]);
+    assert.equal(doc['skynet.linux.logs'].length, 6000);
+    assert.equal(doc['skynet.renderer.diagnostics'].length, 2048);
+    assert.equal(doc['error.stack_trace'].length, 8192);
+    const oversized = base({ padding: 'x'.repeat(128 * 1024) });
+    assert.deepEqual(await (await h.post([oversized])).json(), { accepted: 0, rejected: 1 });
+  } finally {
+    await h.close();
+  }
+});
