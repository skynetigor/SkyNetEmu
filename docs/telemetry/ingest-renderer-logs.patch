+test('renderer diagnostics survive validation in session and error events, with bounded scrubbed text', () => {
+  for (const dataset of ['skynet.session', 'skynet.error']) {
+    const raw = base({
+      'event.dataset': dataset,
+      'event.action': dataset === 'skynet.session' ? 'linux_renderer' : 'launch',
+      'event.outcome': undefined,
+      'skynet.renderer.diagnostics': 'stage=allocate_image_memory vk_result=-2 ' + 'd'.repeat(3000),
+      'skynet.linux.setup': 'renderer=vulkan ' + 's'.repeat(1200),
+      'skynet.linux.logs': 'open /tmp/private/game.log and /usr/local/private.so by player@example.com ' + 'l'.repeat(7000),
+      'skynet.linux.seconds_running': 900000,
+    });
+    const { doc, reason } = validateEvent(raw);
+    assert.equal(reason, undefined);
+    assert.equal(doc['skynet.renderer.diagnostics'].length, 2048);
+    assert.match(doc['skynet.renderer.diagnostics'], /stage=allocate_image_memory vk_result=-2/);
+    assert.equal(doc['skynet.linux.setup'].length, 1000);
+    assert.equal(doc['skynet.linux.logs'].length, 6000);
+    assert.match(doc['skynet.linux.logs'], /open <path> and <path> by <email>/);
+    assert.doesNotMatch(doc['skynet.linux.logs'], /private|player@example/);
+    assert.equal(doc['skynet.linux.seconds_running'], 604800);
+    assert.equal(doc['event.outcome'], undefined);
+  }
+});
+
+test('nested renderer diagnostics are accepted, and unrelated datasets do not acquire log fields', () => {
+  const { doc } = validateEvent(base({
+    'event.action': 'linux_renderer',
+    skynet: { renderer: { diagnostics: 'stage=sampled_image presents=60' }, linux: { logs: 'renderer output', seconds_running: 40 } },
+  }));
+  assert.equal(doc['skynet.renderer.diagnostics'], 'stage=sampled_image presents=60');
+  assert.equal(doc['skynet.linux.logs'], 'renderer output');
+  assert.equal(doc['skynet.linux.seconds_running'], 40);
+  const funnel = validateEvent(base({
+    'event.dataset': 'skynet.funnel', 'event.action': 'game_launched', 'skynet.linux.logs': 'not allowed here',
+  })).doc;
+  assert.equal(funnel['skynet.linux.logs'], undefined);
+});
