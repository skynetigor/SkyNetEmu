+// the template of the mk*temp functions is edited in place: the six letters come back to the program's own copy
+static inline void skyTempBack(char* orig, const char* fixed, int suffix)
+{
+    size_t a = strlen(orig), b = strlen(fixed);
+    if(a < 6u+suffix || b < 6u+suffix || orig==fixed) return;
+    memcpy(orig + a - 6 - suffix, fixed + b - 6 - suffix, 6);
+}
+EXPORT int my_mkstemp(char* t) { char* o=t; ANDROID_FIXPATH(t); int r = mkstemp(t); if(t!=o) skyTempBack(o, t, 0); return r; }
