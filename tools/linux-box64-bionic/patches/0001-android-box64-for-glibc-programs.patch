+// glibc's nl_langinfo items (category << 16 | index) are not bionic's (a flat list): the common ones are translated
+static int androidLanginfoItem(int item)
+{
+    switch(item) {
+        case 14: return CODESET;
+        case 0x10000: return RADIXCHAR;
+        case 0x10001: return THOUSEP;
+        case 0x50000: return YESEXPR;
+        case 0x50001: return NOEXPR;
+        case 0x4000F: return CRNCYSTR;
+        case 0x20026: return AM_STR;
+        case 0x20027: return PM_STR;
+        case 0x20028: return D_T_FMT;
+        case 0x20029: return D_FMT;
+        case 0x2002A: return T_FMT;
+        case 0x2002B: return T_FMT_AMPM;
+    }
+    if(item>=0x20000 && item<0x20007) return ABDAY_1 + (item-0x20000);
+    if(item>=0x20007 && item<0x2000E) return DAY_1 + (item-0x20007);
+    if(item>=0x2000E && item<0x2001A) return ABMON_1 + (item-0x2000E);
+    if(item>=0x2001A && item<0x20026) return MON_1 + (item-0x2001A);
+    return -1;
+}
