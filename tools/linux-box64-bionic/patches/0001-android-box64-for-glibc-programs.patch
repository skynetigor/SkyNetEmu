+static inline const char* skyFixPath(const char* path, char* out, size_t size)
+{
+    if(!path || path[0]!='/') return path;
+    const char* dir = NULL;
+    size_t skip = 0;
+    if(!strncmp(path, "/dev/shm", 8) && (path[8]=='/' || !path[8])) { dir = getenv("BOX64_SHM_DIR"); skip = 8; }
+    else if(!strncmp(path, "/tmp", 4) && (path[4]=='/' || !path[4])) { dir = getenv("TMPDIR"); skip = 4; }
+    // Android denies the battery (EACCES), which a program takes for an error where a machine without one gives ENOENT
+    if(!strncmp(path, "/sys/class/power_supply", 23) && (path[23]=='/' || !path[23])) { snprintf(out, size, "/proc/skynet-enoent%s", path+23); return out; }
+    if(!dir || !*dir) return path;
+    snprintf(out, size, "%s%s", dir, path+skip);
+    return out;
+}
+#define ANDROID_FIXPATH(p) char p##_fix[PATH_MAX]; p = (__typeof__(p))skyFixPath((const char*)(p), p##_fix, sizeof p##_fix)
+
+// Gamepads: Android has no /dev/input for apps. The app writes the controller as evdev events into $SKY_INPUT_DIR/event<N>; a program that opens
+// /dev/input/event<N> is given that file and its ioctls are answered as an Xbox 360 pad (what libskyshim does for the glibc session).
+#define SKY_MAX_PADS 16
+static int sky_pad_fds[SKY_MAX_PADS];
+static int sky_pad_clocks[SKY_MAX_PADS];
+static int sky_pad_count = 0;
+static volatile int sky_pad_lock = 0;
+static void sky_pad_acquire(void) { while(__sync_lock_test_and_set(&sky_pad_lock, 1)) sched_yield(); }
+static void sky_pad_release(void) { __sync_lock_release(&sky_pad_lock); }
+static int skyPadIs(int fd) { int r = 0; sky_pad_acquire(); for(int i=0; i<sky_pad_count; ++i) if(sky_pad_fds[i]==fd) r = 1; sky_pad_release(); return r; }
+static void skyPadRemember(int fd) { sky_pad_acquire(); if(sky_pad_count<SKY_MAX_PADS) { sky_pad_clocks[sky_pad_count] = CLOCK_REALTIME; sky_pad_fds[sky_pad_count++] = fd; } sky_pad_release(); }
+static void skyPadForget(int fd) { sky_pad_acquire(); for(int i=0; i<sky_pad_count; ++i) if(sky_pad_fds[i]==fd) { sky_pad_fds[i] = sky_pad_fds[--sky_pad_count]; sky_pad_clocks[i] = sky_pad_clocks[sky_pad_count]; break; } sky_pad_release(); }
+static int skyPadClock(int fd) { int r = CLOCK_REALTIME; sky_pad_acquire(); for(int i=0; i<sky_pad_count; ++i) if(sky_pad_fds[i]==fd) r = sky_pad_clocks[i]; sky_pad_release(); return r; }
+static void skyPadSetClock(int fd, int c) { sky_pad_acquire(); for(int i=0; i<sky_pad_count; ++i) if(sky_pad_fds[i]==fd) sky_pad_clocks[i] = c; sky_pad_release(); }
+static int skyPadPath(const char* path, char* out, size_t size)
+{
+    if(!path || strncmp(path, "/dev/input/event", 16)) return -1;
+    const char* digits = path+16;
+    if(!*digits) return -1;
+    for(const char* c=digits; *c; ++c) if(*c<'0' || *c>'9') return -1;
+    const char* dir = getenv("SKY_INPUT_DIR");
+    if(!dir || !*dir) return -1;
+    snprintf(out, size, "%s/event%s", dir, digits);
+    return atoi(digits);
+}
+static int skyPadOpen(const char* path, int flags)
+{
+    char backing[512];
+    if(skyPadPath(path, backing, sizeof backing)<0) return -2;
+    int fd = open(backing, (flags & ~(O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)) | O_RDONLY);
+    if(fd>=0) { lseek(fd, 0, SEEK_END); skyPadRemember(fd); }
+    return fd;
+}
+static void skySetBit(unsigned char* bits, size_t size, int n) { if((size_t)(n>>3)<size) bits[n>>3] |= 1<<(n&7); }
+static int skyPadIoctl(unsigned long req, void* arg)
+{
+    unsigned nr = req & 0xff;
+    size_t size = (req>>16) & 0x3fff;
+    if(((req>>8)&0xff)!='E') { errno = ENOTTY; return -1; }
+    if(nr==0x01) { *(int*)arg = 0x010001; return 0; }
+    if(nr==0x02) { struct input_id id = {3, 0x045e, 0x028e, 0x0110}; memcpy(arg, &id, sizeof id); return 0; }
+    if(nr==0x06) { const char* name = "Microsoft X-Box 360 pad"; size_t n = strlen(name)+1; if(n>size) n = size; memcpy(arg, name, n); return (int)n; }
+    if(nr==0x07 || nr==0x08) { errno = ENOENT; return -1; }
+    if(nr==0x09 || nr==0x18 || nr==0x19 || nr==0x1b) { memset(arg, 0, size); return 0; }
+    if(nr>=0x20 && nr<0x40) {
+        int type = nr-0x20;
+        unsigned char* bits = arg;
+        memset(bits, 0, size);
+        if(type==0) { skySetBit(bits, size, EV_SYN); skySetBit(bits, size, EV_KEY); skySetBit(bits, size, EV_ABS); }
+        else if(type==EV_KEY) { static const int keys[] = {0x130,0x131,0x133,0x134,0x136,0x137,0x13a,0x13b,0x13c,0x13d,0x13e}; for(unsigned i=0; i<sizeof keys/sizeof keys[0]; ++i) skySetBit(bits, size, keys[i]); }
+        else if(type==EV_ABS) { static const int axes[] = {ABS_X,ABS_Y,ABS_Z,ABS_RX,ABS_RY,ABS_RZ,ABS_HAT0X,ABS_HAT0Y}; for(unsigned i=0; i<sizeof axes/sizeof axes[0]; ++i) skySetBit(bits, size, axes[i]); }
+        return 0;
+    }
+    if(nr>=0x40 && nr<0x80) {
+        int axis = nr-0x40;
+        struct input_absinfo info;
+        memset(&info, 0, sizeof info);
+        if(axis==ABS_Z || axis==ABS_RZ) { info.minimum = 0; info.maximum = 255; }
+        else if(axis==ABS_HAT0X || axis==ABS_HAT0Y) { info.minimum = -1; info.maximum = 1; }
+        else { info.minimum = -32768; info.maximum = 32767; info.fuzz = 16; info.flat = 128; }
+        memcpy(arg, &info, size<sizeof info ? size : sizeof info);
+        return 0;
+    }
+    if(nr==0x90) return 0;
+    errno = EINVAL;
+    return -1;
+}
+EXPORT int my_ioctl(int fd, unsigned long req, void* arg)
+{
+    if(skyPadIs(fd)) {
+        if((req&0xff)==0xa0 && ((req>>8)&0xff)=='E') { skyPadSetClock(fd, arg?*(const int*)arg:CLOCK_REALTIME); return 0; }
+        return skyPadIoctl(req, arg);
+    }
+    return ioctl(fd, req, arg);
+}
+EXPORT ssize_t my_read(int fd, void* buf, size_t count)
+{
+    ssize_t n = read(fd, buf, count);
+    if(n>=0 && skyPadIs(fd)) {
+        if(n==0) { errno = EAGAIN; return -1; }
+        struct timespec now;
+        if(clock_gettime(skyPadClock(fd), &now)) now.tv_sec = now.tv_nsec = 0;
+        struct input_event* ev = buf;
+        for(size_t i=0; i<(size_t)n/sizeof *ev; ++i) {
+            if(ev[i].type==EV_ABS && ev[i].code==ABS_BRAKE) ev[i].code = ABS_Z;
+            else if(ev[i].type==EV_ABS && ev[i].code==ABS_GAS) ev[i].code = ABS_RZ;
+            ev[i].time.tv_sec = now.tv_sec;
+            ev[i].time.tv_usec = now.tv_nsec/1000;
+        }
+    }
+    return n;
+}
+EXPORT ssize_t my___read(int fd, void* buf, size_t count) { return my_read(fd, buf, count); }
+EXPORT int my_close(int fd) { skyPadForget(fd); return close(fd); }
+EXPORT int my___close(int fd) { return my_close(fd); }
