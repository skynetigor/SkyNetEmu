+// Android's app sandbox refuses the netlink "kobject uevent" socket libudev (and SDL through it) opens to watch for devices: a socket pair end stands
+// in for it, one that never has anything to read.
+#include <sys/socket.h>
+#include <linux/netlink.h>
+#define MY_FAKE_MAX 64
+static int my_fake_fds[MY_FAKE_MAX];
+static int my_fake_count = 0;
+static pthread_mutex_t my_fake_lock = PTHREAD_MUTEX_INITIALIZER;
+static int my_is_fake(int fd)
+{
+    int r = 0;
+    pthread_mutex_lock(&my_fake_lock);
+    for(int i=0; i<my_fake_count; ++i) if(my_fake_fds[i]==fd) { r = 1; break; }
+    pthread_mutex_unlock(&my_fake_lock);
+    return r;
+}
+EXPORT int my_socket(int domain, int type, int protocol)
+{
+    if(domain==AF_NETLINK && protocol==NETLINK_KOBJECT_UEVENT) {
+        int pair[2];
+        if(socketpair(AF_UNIX, SOCK_DGRAM | (type & (SOCK_NONBLOCK|SOCK_CLOEXEC)), 0, pair)==0) {
+            // the other end stays open (and unused), so a read sees "nothing yet" and not end-of-file
+            pthread_mutex_lock(&my_fake_lock);
+            if(my_fake_count<MY_FAKE_MAX) my_fake_fds[my_fake_count++] = pair[0];
+            pthread_mutex_unlock(&my_fake_lock);
+            return pair[0];
+        }
+    }
+    return socket(domain, type, protocol);
+}
+EXPORT int my_bind(int fd, const void* addr, unsigned int len)
+{
+    if(my_is_fake(fd)) return 0;
+    return bind(fd, (const struct sockaddr*)addr, len);
+}
+EXPORT int my_getsockname(int fd, void* addr, void* len)
+{
+    if(my_is_fake(fd)) {
+        struct sockaddr_nl nl;
+        memset(&nl, 0, sizeof nl);
+        nl.nl_family = AF_NETLINK;
+        nl.nl_pid = (unsigned)getpid();
+        socklen_t* l = (socklen_t*)len;
+        socklen_t n = *l < sizeof nl ? *l : sizeof nl;
+        memcpy(addr, &nl, n);
+        *l = sizeof nl;
+        return 0;
+    }
+    return getsockname(fd, (struct sockaddr*)addr, (socklen_t*)len);
+}
+EXPORT int my_setsockopt(int fd, int level, int name, const void* value, unsigned int len)
+{
+    if(my_is_fake(fd)) return 0;
+    return setsockopt(fd, level, name, value, len);
+}
+EXPORT int my_getsockopt(int fd, int level, int name, void* value, void* len)
+{
+    if(my_is_fake(fd) && level==SOL_SOCKET && (name==SO_RCVBUF || name==SO_SNDBUF) && value && *(socklen_t*)len>=sizeof(int)) {
+        *(int*)value = 1<<20;
+        *(socklen_t*)len = sizeof(int);
+        return 0;
+    }
+    return getsockopt(fd, level, name, value, (socklen_t*)len);
+}
