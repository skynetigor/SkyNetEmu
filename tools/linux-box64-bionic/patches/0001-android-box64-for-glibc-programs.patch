diff --git a/src/wrapped/wrappedlibc_androidcompat.h b/src/wrapped/wrappedlibc_androidcompat.h
new file mode 100644
index 000000000..9850ab76f
--- /dev/null
+++ b/src/wrapped/wrappedlibc_androidcompat.h
@@ -0,0 +1,373 @@
+// Box64 on Android (bionic): the glibc-only functions an x86-64 program's libraries import from libc.so.6.
+// bionic has no __errno_location, __ctype_b_loc, __assert_fail, gettext... (it has __errno, _ctype_, __assert2, no libintl), and the wrapper
+// looks every name of libc.so.6 up in the native libc, so a library that links against one of them fails to load.
+// Each function here is mapped by a GOM entry in wrappedlibc_private.h (names my_<name>, no emulator argument).
+#include <errno.h>
+#include <langinfo.h>
+#include <fcntl.h>
+#include <locale.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <wchar.h>
+#include <wctype.h>
+#include <ctype.h>
+#include <limits.h>
+#include <stdio.h>
+#include <signal.h>
+#include <assert.h>
+extern void __assert2(const char*, int, const char*, const char*);
+
+EXPORT void* my___errno_location(void) { return __errno(); }
+
+static int my___h_errno_value = 0;
+EXPORT void* my___h_errno_location(void) { return &my___h_errno_value; }
+
+// glibc's character tables: indexed from -128 to 255, the C locale's classes; the pointer a caller gets points at index 0.
+static unsigned short ct_b_store[384];
+static int32_t ct_lower_store[384];
+static int32_t ct_upper_store[384];
+static const unsigned short* ct_b_ptr = NULL;
+static const int32_t* ct_lower_ptr = NULL;
+static const int32_t* ct_upper_ptr = NULL;
+
+static void ct_init(void)
+{
+    if(ct_b_ptr) return;
+    for(int c=-128; c<256; ++c) {
+        unsigned short b = 0;
+        int32_t lo = c, up = c;
+        if(c>=0 && c<128) {
+            // glibc (little endian): _ISupper 0x100, _ISlower 0x200, _ISalpha 0x400, _ISdigit 0x800, _ISxdigit 0x1000, _ISspace 0x2000,
+            // _ISprint 0x4000, _ISgraph 0x8000, _ISblank 0x1, _IScntrl 0x2, _ISpunct 0x4, _ISalnum 0x8
+            if(isupper(c))  b |= 0x100;
+            if(islower(c))  b |= 0x200;
+            if(isalpha(c))  b |= 0x400;
+            if(isdigit(c))  b |= 0x800;
+            if(isxdigit(c)) b |= 0x1000;
+            if(isspace(c))  b |= 0x2000;
+            if(isprint(c))  b |= 0x4000;
+            if(isgraph(c))  b |= 0x8000;
+            if(c==' ' || c=='\t') b |= 0x1;
+            if(iscntrl(c))  b |= 0x2;
+            if(ispunct(c))  b |= 0x4;
+            if(isalnum(c))  b |= 0x8;
+            lo = tolower(c);
+            up = toupper(c);
+        }
+        ct_b_store[c+128] = b;
+        ct_lower_store[c+128] = lo;
+        ct_upper_store[c+128] = up;
+    }
+    ct_lower_ptr = ct_lower_store+128;
+    ct_upper_ptr = ct_upper_store+128;
+    ct_b_ptr = ct_b_store+128;
+}
+EXPORT void* my___ctype_b_loc(void) { ct_init(); return (void*)&ct_b_ptr; }
+EXPORT void* my___ctype_tolower_loc(void) { ct_init(); return (void*)&ct_lower_ptr; }
+EXPORT void* my___ctype_toupper_loc(void) { ct_init(); return (void*)&ct_upper_ptr; }
+
+EXPORT void my___assert_fail(const char* assertion, const char* file, unsigned int line, const char* function)
+{
+    __assert2(file, (int)line, function?function:"", assertion);
+}
+EXPORT unsigned long my___fdelt_chk(unsigned long d)
+{
+    if(d >= 1024) abort();
+    return d / (8*sizeof(long));
+}
+EXPORT int my_bcmp(const void* a, const void* b, size_t n) { return memcmp(a, b, n); }
+EXPORT void* my___rawmemchr(const void* s, int c)
+{
+    const unsigned char* p = (const unsigned char*)s;
+    while(*p != (unsigned char)c) ++p;
+    return (void*)p;
+}
+EXPORT char* my___strdup(const char* s) { return strdup(s); }
+EXPORT char* my___strtok_r(char* s, const char* d, char** save) { return strtok_r(s, d, save); }
+EXPORT int my___open64_2(const char* path, int flags) { return open(path, flags); }
+EXPORT int my___openat64_2(int dirfd, const char* path, int flags) { return openat(dirfd, path, flags); }
+EXPORT struct tm* my___gmtime_r(const time_t* t, struct tm* r) { return gmtime_r(t, r); }
+EXPORT ssize_t my___getdelim(char** line, size_t* n, int delim, FILE* f) { return getdelim(line, n, delim, f); }
+EXPORT int my___overflow(FILE* f, int ch) { return fputc(ch, f); }
+EXPORT size_t my___mbrlen(const char* s, size_t n, mbstate_t* ps) { return mbrlen(s, n, ps); }
+EXPORT size_t my___mbstowcs_chk(wchar_t* dst, const char* src, size_t len, size_t dstlen) { (void)dstlen; return mbstowcs(dst, src, len); }
+EXPORT wchar_t* my___wcsncpy_chk(wchar_t* d, const wchar_t* s, size_t n, size_t dstlen) { (void)dstlen; return wcsncpy(d, s, n); }
+EXPORT wchar_t* my___wmemcpy_chk(wchar_t* d, const wchar_t* s, size_t n, size_t dstlen) { (void)dstlen; return wmemcpy(d, s, n); }
+EXPORT wchar_t* my___wmemmove_chk(wchar_t* d, const wchar_t* s, size_t n, size_t dstlen) { (void)dstlen; return wmemmove(d, s, n); }
+
+// locale: the C locale only. glibc's locale_t masks and names differ from bionic's, so the objects here are placeholders: libstdc++ asks for "C" and
+// only needs a non-null handle back.
+// glibc's locale_t is a struct whose ctype fields libstdc++ reads directly (ctype<char>::classic_table() takes __ctype_b from it)
+struct my_glibc_locale {
+    void* locales[13];
+    const unsigned short* ctype_b;
+    const int* ctype_tolower;
+    const int* ctype_toupper;
+    const char* names[13];
+};
+static struct my_glibc_locale my_locale_c;
+static void* my_locale_dummy_ptr(void)
+{
+    if(!my_locale_c.ctype_b) {
+        ct_init();
+        my_locale_c.ctype_b = ct_b_ptr;
+        my_locale_c.ctype_tolower = ct_lower_ptr;
+        my_locale_c.ctype_toupper = ct_upper_ptr;
+        for(int i=0; i<13; ++i) my_locale_c.names[i] = "C";
+    }
+    return &my_locale_c;
+}
+EXPORT long my___timezone = 0;
+EXPORT void* my___newlocale(int mask, const char* name, void* base)
+{
+    (void)mask;
+    if(!name || !*name || !strcmp(name, "C") || !strcmp(name, "POSIX") || !strncmp(name, "C.", 2) || !strncmp(name, "en_US", 5)) return base ? base : my_locale_dummy_ptr();
+    errno = ENOENT;
+    return NULL;
+}
+EXPORT void* my___uselocale(void* loc) { (void)loc; return my_locale_dummy_ptr(); }
+EXPORT void my___freelocale(void* loc) { (void)loc; }
+EXPORT void* my___duplocale(void* loc) { (void)loc; return my_locale_dummy_ptr(); }
+EXPORT void* my_newlocale(int mask, const char* name, void* base) { return my___newlocale(mask, name, base); }
