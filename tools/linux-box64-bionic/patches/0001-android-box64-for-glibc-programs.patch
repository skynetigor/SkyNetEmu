+#if defined(DYNAREC) && defined(ARM64)
+// A signal that lands in a dynablock right after a native function returned (the code that calls a wrapped function) finds the x86 registers living in the
+// ARM caller-saved registers (x10-x17) overwritten by that function: they were saved in the emu (or on the ARM stack) before the call and are reloaded just
+// after it. Put the saved values back in the emu, the way the reload would.
+static int isArmBLR(uint32_t op) { return (op&0xFFFFFC1F)==0xD63F0000; }
+static int isArmLDPoff(uint32_t op, int rt, int rt2, int rn, int offs)
+{
+    return (op&0xFFC00000)==0xA9400000 && (int)(op&31)==rt && (int)((op>>10)&31)==rt2 && (int)((op>>5)&31)==rn && ((int)((op>>15)&0x7f))*8==offs;
+}
+static int isArmLDPpost(uint32_t op, int rt, int rt2)
+{
+    return (op&0xFFC00000)==0xA8C00000 && (int)(op&31)==rt && (int)((op>>10)&31)==rt2 && (int)((op>>5)&31)==31;
+}
+static void fixNativeCallWindow(x64emu_t* emu, ucontext_t* p, void* pc, const uint64_t* saved)
+{
+    uint32_t* ip = (uint32_t*)pc;
+    int after_blr = 0, blr_x16 = 0;
+    for(int k=1; k<=8 && !after_blr; ++k) {
+        if(isArmBLR(ip[-k])) { after_blr = 1; blr_x16 = (ip[-k]==0xD63F0200); }
+    }
+    if(!after_blr) return;
+    // call_c: all of RAX..R9 were stored in the emu, and are loaded back from it after the call
+    for(int k=0; k<8; ++k) {
+        if(isArmBLR(ip[k])) break;
+        if(isArmLDPoff(ip[k], xRAX, xRCX, xEmu, offsetof(x64emu_t, regs[_AX]))) {
+            emu->regs[_AX].q[0] = saved[_AX]; emu->regs[_CX].q[0] = saved[_CX]; emu->regs[_DX].q[0] = saved[_DX]; emu->regs[_BX].q[0] = saved[_BX];
+            emu->regs[_SP].q[0] = saved[_SP]; emu->regs[_BP].q[0] = saved[_BP]; emu->regs[_SI].q[0] = saved[_SI]; emu->regs[_DI].q[0] = saved[_DI];
+            emu->regs[_R8].q[0] = saved[_R8]; emu->regs[_R9].q[0] = saved[_R9];
+            return;
+        }
+    }
+    // call_n: RSP and RBP were stored in the emu and RBX on the ARM stack, all three loaded back after the call
+    if(!blr_x16) return;
+    for(int k=0; k<8; ++k) {
+        if(isArmBLR(ip[k])) break;
+        if(isArmLDPpost(ip[k], xEmu, xRBX)) {
+            // RBX not loaded yet: it is on the ARM stack, next to the emu pointer
+            emu->regs[_BX].q[0] = *(uint64_t*)(CONTEXT_REG(p, 31)+8);
+            emu->regs[_SP].q[0] = saved[_SP]; emu->regs[_BP].q[0] = saved[_BP];
+            return;
+        }
+        if(isArmLDPoff(ip[k], xRSP, xRBP, xEmu, offsetof(x64emu_t, regs[_SP]))) {
+            emu->regs[_SP].q[0] = saved[_SP]; emu->regs[_BP].q[0] = saved[_BP];
+            return;
+        }
+    }
+}
+#endif
