diff --git a/src/wrapped/wrappedlibpthread.c b/src/wrapped/wrappedlibpthread.c
index aefce4154..977f6abd8 100644
--- a/src/wrapped/wrappedlibpthread.c
+++ b/src/wrapped/wrappedlibpthread.c
@@ -61,6 +61,25 @@ EXPORT void my___pthread_initialize()
     // nothing, the lib initialize itself now
 }
 
+#ifdef ANDROID
+// glibc's static initializers (PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP, ...) put the mutex type in the "kind" field (offset 16); bionic keeps it in the
+// top bits of the first word. Give a mutex that is still untouched the type its x86 initializer asked for.
+static inline void androidMutexKind(void* m)
+{
+    int kind = *(int*)((uintptr_t)m + 16) & 3;
+    if(!kind) return;
+    int bits = kind==1 ? 0x4000 : kind==2 ? 0x8000 : 0;
+    if(!bits) return;
+    int zero = 0;
+    __atomic_compare_exchange_n((int*)m, &zero, bits, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+EXPORT int my_pthread_mutex_lock(void* m) { androidMutexKind(m); return pthread_mutex_lock(m); }
+EXPORT int my___pthread_mutex_lock(void* m) __attribute__((alias("my_pthread_mutex_lock")));
+EXPORT int my_pthread_mutex_trylock(void* m) { androidMutexKind(m); return pthread_mutex_trylock(m); }
+EXPORT int my___pthread_mutex_trylock(void* m) __attribute__((alias("my_pthread_mutex_trylock")));
+EXPORT int my_pthread_mutex_timedlock(void* m, void* t) { androidMutexKind(m); return pthread_mutex_timedlock(m, t); }
+#endif
+
 #ifdef STATICBUILD
 #include <semaphore.h>
 #include <signal.h>
