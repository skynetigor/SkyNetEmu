+// A thread of the program stuck somewhere: kill(SIGPWR) to one thread (tgkill) prints where its emulated code is. Debugging only.
+static void my_dumpthread_handler(int sig, siginfo_t* info, void* ucntx)
+{
+    (void)sig; (void)info;
+    x64emu_t* emu = thread_get_emu_no_create();
+    if(!emu) return;
+    #define BT_BUF_SIZE 100
+    void *buffer[BT_BUF_SIZE];
+    extern int my_backtrace_ip(x64emu_t* emu, void** buffer, int size);
+    extern char** my_backtrace_symbols(x64emu_t* emu, uintptr_t* buffer, int size);
+    #define GO(A) uintptr_t old_##A = R_##A;
+    GO(RSP); GO(RBP); GO(RIP);
+    #undef GO
+    #ifdef DYNAREC
+    ucontext_t* p = (ucontext_t*)ucntx;
+    void* pc = (void*)CONTEXT_PC(p);
+    dynablock_t* db = FindDynablockFromNativeAddress(pc);
+    if(db) {
+        uintptr_t x64pc = getX64Address(db, (uintptr_t)pc);
+        if(x64pc) copyUCTXreg2Emu(emu, p, x64pc);
+    }
+    #endif
+    printf_log(LOG_NONE, "DUMPTHREAD %d: x64 RIP=%p RSP=%p (native pc %p)\n", GetTID(), (void*)R_RIP, (void*)R_RSP, pc);
+    int nptrs = my_backtrace_ip(emu, buffer, BT_BUF_SIZE);
+    char** strings = my_backtrace_symbols(emu, (uintptr_t*)buffer, nptrs);
+    if(strings) {
+        for(int j=0; j<nptrs; ++j) printf_log(LOG_NONE, "DUMPTHREAD %d:   %s\n", GetTID(), strings[j]);
+        free(strings);
+    }
+    #define GO(A) R_##A = old_##A
+    GO(RSP); GO(RBP); GO(RIP);
+    #undef GO
+}
